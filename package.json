  "keywords": ["cli", "update", "self-update", "uninstall", "installer", "npm", "bun"],
  "repository": { "type": "git", "url": "git+https://github.com/profullstack/cli.git" },
  "homepage": "https://github.com/profullstack/cli#readme",
  "bugs": { "url": "https://github.com/profullstack/cli/issues" },
  "license": "MIT",
  "author": "Profullstack, Inc.",
  "exports": {
    ".": { "types": "./index.d.ts", "import": "./src/index.js" },
    "./auto-update": { "types": "./auto-update.d.ts", "import": "./src/auto-update.js" },
    "./package.json": "./package.json"
  },
  "types": "./index.d.ts",
  "files": ["src", "index.d.ts", "auto-update.d.ts", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": { "node": ">=18" },
  "scripts": {
    "test": "node --test"
  }
